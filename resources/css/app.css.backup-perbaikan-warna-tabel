@tailwind base;
@tailwind components;
@tailwind utilities;

/* Sembunyikan scrollbar tapi tetap bisa di-scroll */
.no-scrollbar {
    scrollbar-width: none;
    -ms-overflow-style: none;
}

.no-scrollbar::-webkit-scrollbar {
    display: none;
}

/* ===== TEMA TABEL BIRU GELAP PERPUSTAKAAN ===== */
table {
    background-color: #142740 !important;
    color: #e2e8f0 !important;
    border-color: #344b68 !important;
}

table thead th {
    background-color: #203a59 !important;
    color: #f1f5f9 !important;
    border-color: #405875 !important;
}

table tbody td {
    background-color: #142740 !important;
    color: #e2e8f0 !important;
    border-color: #344b68 !important;
}

table tbody tr:hover td {
    background-color: #1c3450 !important;
}

/* Pertahankan keterbacaan teks tabel */
table th,
table td {
    border-style: solid;
}
/* ===== AKHIR TEMA TABEL ===== */

/* ===== PENYERAGAMAN TEMA NAVY TABEL ===== */

/* Pembungkus tabel yang sebelumnya putih/abu-abu */
.bg-white:has(table),
.bg-gray-50:has(table),
.bg-gray-100:has(table) {
    background-color: #0b1d32 !important;
    color: #e2e8f0 !important;
}

/* Permukaan tabel */
table {
    background-color: #0b1d32 !important;
    color: #e2e8f0 !important;
    border-color: #2c4563 !important;
}

/* Header tabel */
table thead,
table thead tr,
table thead th {
    background-color: #193451 !important;
    color: #f1f5f9 !important;
    border-color: #344e6c !important;
}

/* Isi tabel dan baris */
table tbody tr,
table tbody td {
    background-color: #0b1d32 !important;
    color: #e2e8f0 !important;
    border-color: #2c4563 !important;
}

/* Warna teks gelap di dalam tabel dibuat terang */
table .text-gray-900,
table .text-gray-800,
table .text-gray-700,
table .text-gray-600,
table .text-black {
    color: #e2e8f0 !important;
}

/* Hover baris */
table tbody tr:hover td {
    background-color: #193451 !important;
}

/* Jangan mengubah warna teks tombol aksi */
table button,
table a {
    /* Warna tombol dan tautan tetap mengikuti desain aslinya */
}

