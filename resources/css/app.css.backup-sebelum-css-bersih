@tailwind base;
@tailwind components;
@tailwind utilities;

/* Sembunyikan scrollbar tapi tetap bisa di-scroll */
.no-scrollbar {
    scrollbar-width: none;
    -ms-overflow-style: none;
}

.no-scrollbar::-webkit-scrollbar {
    display: none;
}

/* ===== TEMA NAVY GLOBAL UNTUK SELURUH TABEL ===== */

/* Warna dasar panel tabel */
.bg-white:has(table),
.bg-gray-50:has(table),
.bg-gray-100:has(table),
.bg-slate-50:has(table),
.bg-slate-100:has(table) {
    background-color: #0b1d32 !important;
    color: #e2e8f0 !important;
    border-color: #263e5b !important;
}

/* Tabel utama */
table {
    background-color: #0b1d32 !important;
    color: #e2e8f0 !important;
    border-color: #263e5b !important;
}

/* Header tabel: navy sedang, bukan putih atau biru terang */
table thead,
table thead tr,
table thead th {
    background-color: #102640 !important;
    color: #dbeafe !important;
    border-color: #263e5b !important;
}

/* Sel tabel: navy gelap */
table tbody,
table tbody tr,
table tbody td {
    background-color: #0b1d32 !important;
    color: #e2e8f0 !important;
    border-color: #263e5b !important;
}

/* Baris bergantian jika menggunakan kelas Tailwind */
table tbody tr:nth-child(even) td {
    background-color: #0e2239 !important;
}

/* Hover baris */
table tbody tr:hover td {
    background-color: #193451 !important;
    color: #f8fafc !important;
}

/* Teks gelap di dalam tabel menjadi terang */
table .text-gray-900,
table .text-gray-800,
table .text-gray-700,
table .text-gray-600,
table .text-gray-500,
table .text-black,
table .text-slate-900,
table .text-slate-800,
table .text-slate-700,
table .text-slate-600 {
    color: #e2e8f0 !important;
}

/* Panel pencarian/filter yang menempel dengan tabel */
.bg-white:has(table) form,
.bg-gray-50:has(table) form,
.bg-gray-100:has(table) form {
    border-color: #263e5b !important;
}

/* Input pencarian dan filter pada panel tabel */
.bg-white:has(table) input,
.bg-white:has(table) select,
.bg-gray-50:has(table) input,
.bg-gray-50:has(table) select,
.bg-gray-100:has(table) input,
.bg-gray-100:has(table) select {
    background-color: #071426 !important;
    color: #e2e8f0 !important;
    border-color: #304966 !important;
}

/* Placeholder input */
.bg-white:has(table) input::placeholder,
.bg-gray-50:has(table) input::placeholder,
.bg-gray-100:has(table) input::placeholder {
    color: #94a3b8 !important;
}

/* Pagination di dalam panel tabel */
.bg-white:has(table) nav,
.bg-gray-50:has(table) nav,
.bg-gray-100:has(table) nav {
    color: #e2e8f0 !important;
}

/* ===== AKHIR TEMA NAVY GLOBAL UNTUK SELURUH TABEL ===== */



